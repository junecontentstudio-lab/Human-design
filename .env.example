# Adresse de ton site, sans / à la fin
SITE_URL=https://www.ton-domaine.fr
# Prix en euros (mets 1 pour tester, puis 22)
PRICE_EUR=22
# Une longue phrase secrète au hasard (au moins 32 caractères)
TOKEN_SECRET=remplace-moi-par-une-longue-phrase-secrete-au-hasard

# SumUp
SUMUP_API_KEY=sup_sk_xxxxxxxx
SUMUP_MERCHANT_CODE=MXXXXXXX

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# Brevo
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=bonjour@ton-domaine.fr
BREVO_SENDER_NAME=Ma Boussole Business
BREVO_LIST_PROSPECTS=2
BREVO_LIST_CLIENTS=3

# Supabase (Project Settings → API) : prospects, paiements, limite d'appels IA
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx
# Nombre maximal d'appels IA par achat (un comité complet = 6 appels)
AI_CALLS_LIMIT=60
# Code d'accès de test (version complète sans paiement). Lien à partager : SITE_URL/?code=CE_CODE
# Le changer ou le supprimer révoque tous les accès de test. Laisser vide en production.
