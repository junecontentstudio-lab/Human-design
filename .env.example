# Adresse de ton site, sans / à la fin
SITE_URL=https://www.businessdesign.fr
# Prix en euros (mets 1 pour tester, puis 22)
PRICE_EUR=22
# Une longue phrase secrète au hasard (au moins 32 caractères)
TOKEN_SECRET=remplace-moi-par-une-longue-phrase-secrete-au-hasard

# SumUp
SUMUP_API_KEY=sup_sk_xxxxxxxx
SUMUP_MERCHANT_CODE=MXXXXXXX

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# E-mails — option recommandée : Resend, depuis l'adresse de ton domaine (vérifié dans Resend)
RESEND_API_KEY=re_xxxxxxxx
SENDER_EMAIL=ludivine@businessdesign.fr
# Adresse où arrivent les réponses des clientes (ta boîte Hostinger), facultatif
REPLY_TO=ludivine@businessdesign.fr

# E-mails — autre option : envoi depuis ton adresse Gmail
# Mot de passe d'application : compte Google → Sécurité → Validation en deux étapes → Mots de passe des applications
GMAIL_USER=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Ma Boussole Business by Business Design

# E-mails — dernière option : Brevo (inutile si Resend ou Gmail est configuré)
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=bonjour@ton-domaine.fr
BREVO_SENDER_NAME=Ma Boussole Business by Business Design
BREVO_LIST_PROSPECTS=2
BREVO_LIST_CLIENTS=3

# Supabase (Project Settings → API) : prospects, paiements, limite d'appels IA
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx
# Nombre maximal d'appels IA par achat (un comité complet = 6 appels)
AI_CALLS_LIMIT=60
# Mode test ouvert : mets 1 pour offrir la version complète à tout le monde, sans code ni paiement.
# Remets 0 (ou supprime la ligne) pour ouvrir les ventes : les testeuses gardent leur accès.
FREE_ACCESS=0
# Mets 1 pour retirer l'accès complet à toutes les testeuses (les clientes ne sont pas concernées).
REVOKE_TEST_ACCESS=0
